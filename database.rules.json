{
  "rules": {
    ".read": false,
    ".write": false,
    "quiz": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "games": {
      "$code": {
        ".read": "auth != null && data.child('host').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && auth.token.firebase.sign_in_provider === 'password') || (data.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$code.matches(/^[0-9]{6}$/)",
        "host": { ".read": "auth != null" },
        "settings": { ".read": "auth != null" },
        "state": { ".read": "auth != null" },
        "current": { ".read": "auth != null" },
        "scores": { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('games').child($code).child('host').exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24"
          }
        },
        "answers": {
          "$q": {
            "$pid": {
              ".read": "auth != null && auth.uid === $pid",
              ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('games').child($code).child('players').child($pid).exists() && root.child('games').child($code).child('state/phase').val() === 'question' && root.child('games').child($code).child('state/qkey').val() === $q && now <= root.child('games').child($code).child('state/startedAt').val() + root.child('games').child($code).child('state/duration').val() * 1000 + 2000",
              ".validate": "newData.hasChildren(['v', 't']) && newData.child('v').isNumber() && newData.child('t').val() === now"
            }
          }
        }
      }
    }
  }
}
